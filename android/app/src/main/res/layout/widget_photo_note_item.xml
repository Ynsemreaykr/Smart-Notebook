<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photo_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Indentation Spacer -->
    <FrameLayout
        android:id="@+id/photo_item_indent"
        android:layout_width="16dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- Colored accent bar -->
    <FrameLayout
        android:id="@+id/photo_item_accent"
        android:layout_width="3dp"
        android:layout_height="24dp"
        android:background="#14B8A6"
        android:layout_marginEnd="8dp" />

    <!-- Title and Category info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/photo_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/photo_item_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
